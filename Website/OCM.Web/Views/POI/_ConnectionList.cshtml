@model IEnumerable<OCM.API.Common.Model.ConnectionInfo>

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 mb-0 ocm-equipment-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <h3 class="h6 mb-0">
                            <i class="fa-solid fa-plug text-body-secondary me-1" aria-hidden="true"></i>
                            @if (item.ConnectionType == null)
                            {
                                <span data-localize="ocm.reference.connectionType.value_0">Connection Type Unknown</span>
                            }
                            else
                            {
                                <span data-localize="ocm.reference.connectionType.value_@item.ConnectionTypeID">@item.ConnectionType.Title</span>
                            }
                        </h3>
                        @if (item.Quantity != null)
                        {
                            <span class="badge rounded-pill bg-body-tertiary text-body-secondary border text-nowrap">@Html.DisplayFor(modelItem => item.Quantity) present</span>
                        }
                    </div>

                    <div class="mb-3">
                        @if (item.StatusType == null)
                        {
                            <span class="badge rounded-pill text-bg-secondary" data-localize="ocm.reference.statusType.value_0">Status Unknown</span>
                        }
                        else
                        {
                            <span class="badge rounded-pill @(item.StatusType.IsOperational == true ? "bg-success-subtle text-success-emphasis" : "text-bg-warning")" data-localize="ocm.reference.statusType.value_@item.StatusTypeID">@item.StatusType.Title</span>
                        }
                    </div>

                    <div class="ocm-equipment-specs">
                        @if (item.PowerKW != null)
                        {
                            <div><span class="ocm-equipment-value">@item.PowerKW</span> kW</div>
                        }
                        @if (item.Voltage != null)
                        {
                            <div><span class="ocm-equipment-value">@item.Voltage</span> V</div>
                        }
                        @if (item.Amps != null)
                        {
                            <div><span class="ocm-equipment-value">@item.Amps</span> A</div>
                        }
                        @if (item.CurrentType != null)
                        {
                            <div data-localize="ocm.reference.supplyType.value_@item.CurrentTypeID">@item.CurrentType.Title</div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(item.Comments))
                    {
                        <p class="small mt-3 mb-0">@item.Comments</p>
                    }
                </div>
                <div class="card-footer small text-body-secondary">
                    <i class="fa-solid fa-bolt me-1" aria-hidden="true"></i>OCM-CN-@item.ID
                </div>
            </div>
        </div>
    }
</div>
