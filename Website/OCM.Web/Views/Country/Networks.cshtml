@model IEnumerable<OCM.API.Common.Model.OperatorInfo>

@{

    var country = (OCM.API.Common.Model.Country)ViewBag.Country;

    var countryName = (country.Title.StartsWith("United") ? " the " + country.Title : country.Title);
    ViewBag.Title = "Charging Networks in "+countryName;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">Home</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index","Country")">Countries</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index","Country")#@country.ISOCode">@country.Title</a></li>
        <li class="breadcrumb-item active" aria-current="page">Networks</li>
    </ol>
</nav>

<h1>Charging Networks in @countryName</h1>

@if (Model != null && Model.Count() > 0)
{
    <p class="mb-4">The following charging networks are known to operate in @countryName. If you can see that one is missing, please @Html.ActionLink("Contact Us", "Contact", "About").</p>

    <div class="row row-cols-1 row-cols-lg-2 g-3">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 mb-0">
                    <div class="card-body">
                        <h2 class="h5 mb-1">@Html.DisplayFor(modelItem => item.Title)</h2>
                        <a class="small" href="@Url.Action("Index","POI",new {CountryIds=country.ID, OperatorIds=item.ID})">View <strong>@Html.DisplayFor(modelItem => item.Title)</strong> charging locations in @countryName</a>

                        @if (!string.IsNullOrWhiteSpace(item.Comments))
                        {
                            <p class="small text-body-secondary mt-2 mb-0">@Html.DisplayFor(modelItem => item.Comments)</p>
                        }

                        <dl class="ocm-facts small mt-3 mb-0">
                            @if (item.WebsiteURL != null)
                            {
                                <dt>Website</dt>
                                <dd class="text-break">@Html.DisplayFor(modelItem => item.WebsiteURL)</dd>
                            }
                            @if (item.PhonePrimaryContact != null)
                            {
                                <dt>Main Phone</dt>
                                <dd>@Html.DisplayFor(modelItem => item.PhonePrimaryContact)</dd>
                            }
                            @if (item.BookingURL != null)
                            {
                                <dt>Booking/Membership</dt>
                                <dd class="text-break">@Html.DisplayFor(modelItem => item.BookingURL)</dd>
                            }
                            @if (item.ContactEmail != null)
                            {
                                <dt>Contact Email</dt>
                                <dd class="text-break">@Html.DisplayFor(modelItem => item.ContactEmail)</dd>
                            }
                            @if (item.FaultReportEmail != null)
                            {
                                <dt>Fault Report Email</dt>
                                <dd class="text-break">@Html.DisplayFor(modelItem => item.FaultReportEmail)</dd>
                            }
                        </dl>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>There are currently no known charging networks for this country. If you know one is missing, please @Html.ActionLink("Contact Us", "Contact", "About")</p>
}

<h2 class="h4 mt-5">Other Charging Providers</h2>
<p><a href="@Url.Action("Index", "POI", new { CountryIds = country.ID })">Charging Locations provided by Business Owners or Unknown Networks</a></p>
