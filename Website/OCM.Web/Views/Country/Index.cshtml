@model IEnumerable<OCM.API.Common.Model.Country>

@{
    ViewBag.Title = "Countries";
    var continents = (Dictionary<string, string>)ViewBag.Continents;
    var countryStats = (List<OCM.API.Common.DataSummary.CountrySummary>)ViewBag.CountryStats;
}

<h1>All Countries</h1>

<p>
    We have information on charging locations in the following countries, if your country is not listed we need you to <a href="@Url.Action("Add","POI")">add the locations</a> you know about.
</p>
@Html.Partial("~/Views/Widget/_GeoChartWidget.cshtml")
<div>
    @foreach (var continent in continents)
    {
        var continentCountries = Model.Where(c => c.ContinentCode == continent.Key)
            .Select(c => new { Country = c, Stat = countryStats.FirstOrDefault(cs => cs.ISOCode == c.ISOCode) })
            .Where(c => c.Stat != null)
            .ToList();

        if (!continentCountries.Any()) { continue; }

        <h2 class="h4 mt-4 mb-3">@continent.Value</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3">
            @foreach (var entry in continentCountries)
            {
                var item = entry.Country;
                var countryStat = entry.Stat;
                var countryNameParam = item.Title.Replace(" ", "").ToLower();

                <div class="col">
                    <div class="card h-100 mb-0" id="@item.ISOCode">
                        <div class="card-body">
                            <h3 class="h6 mb-2">@Html.DisplayFor(modelItem => item.Title)</h3>
                            <a class="d-block small mb-1" href="@Url.Action("Index", "POI", new { CountryIDs=item.ID, CountryName=countryNameParam})">@countryStat.StationCount charging stations in @countryStat.LocationCount locations</a>
                            <a class="small" href="@Url.Content("~/country/" +countryNameParam +"/networks")">Networks</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
