@model OCM.API.Utils.PaginatedCollection<OCM.API.Common.Model.OperatorInfo>

@{
    ViewBag.Title = "Operators";
    var keyword = ViewData["keyword"] as string;
    var countryId = ViewData["countryId"] as int?;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12 col-lg-10 col-xl-8">
            <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
                <div>
                    <h2 class="mb-2">Operators</h2>
                    <p class="text-muted mb-0">Browse, filter, create, or edit operator records.</p>
                </div>
                <a href="@Url.RouteUrl("AdminOperatorCreate")" class="btn btn-primary mt-2">Create operator</a>
            </div>

            <div class="card mb-4">
                <div class="card-header h5 mb-0">Filter operators</div>
                <div class="card-body">
                    @using (Html.BeginForm("Operators", "Admin", FormMethod.Get))
                    {
                        <div class="form-row align-items-end">
                            <div class="form-group col-md-5 mb-md-0">
                                <label for="keyword">Operator name</label>
                                <input type="search" id="keyword" name="keyword" value="@keyword" class="form-control" placeholder="Search by operator name" minlength="2" />
                            </div>
                            <div class="form-group col-md-5 mb-md-0">
                                <label for="countryId">Country</label>
                                @Html.DropDownList("countryId", (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.CountryList, new { @class = "custom-select" })
                            </div>
                            <div class="form-group col-md-2 mb-0">
                                <button type="submit" class="btn btn-outline-secondary btn-block form-control">Apply</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (ViewBag.SearchTooShort == true)
            {
                <div class="alert alert-danger">Enter at least 2 characters to search.</div>
            }
            else if (!Model.Any())
            {
                <div class="alert alert-info">No matching operators found.</div>
            }
            else
            {
                <div class="card">
                    <div class="card-header h5 mb-0">@Model.TotalResults operator@(Model.TotalResults == 1 ? "" : "s")</div>
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap">
                                <div>
                                    <strong>@item.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.WebsiteURL))
                                    {
                                        <div><small class="text-muted">@item.WebsiteURL</small></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.FaultReportEmail))
                                    {
                                        <div><small class="text-muted">@item.FaultReportEmail</small></div>
                                    }
                                </div>
                                <a href="@Url.RouteUrl("AdminOperatorEdit", new { id = item.ID })" class="btn btn-outline-secondary mt-2">Edit</a>
                            </div>
                        }
                    </div>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-3" aria-label="Operator results">
                        <ul class="pagination">
                            <li class="page-item@(!Model.HasPreviousPage ? " disabled" : "")">
                                <a class="page-link" href="@Url.Action("Operators", new { keyword, countryId, pageIndex = Model.PageIndex - 1 })">Previous</a>
                            </li>
                            <li class="page-item disabled"><span class="page-link">Page @Model.PageIndex of @Model.TotalPages</span></li>
                            <li class="page-item@(!Model.HasNextPage ? " disabled" : "")">
                                <a class="page-link" href="@Url.Action("Operators", new { keyword, countryId, pageIndex = Model.PageIndex + 1 })">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
