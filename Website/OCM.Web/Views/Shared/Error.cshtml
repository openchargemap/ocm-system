@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Error - Open Charge Map</title>
    <style>
        :root { color-scheme: light dark; --bg: #f6f8f7; --surface: #fff; --text: #1a2420; --muted: #5b6a62; --border: #dfe6e1; --brand: #1f6f35; }
        @@media (prefers-color-scheme: dark) {
            :root { --bg: #0f1512; --surface: #161e1a; --text: #dfe7e2; --muted: #9aaba1; --border: #2a3630; --brand: #8ec760; }
        }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 1rem; background: var(--bg); color: var(--text); font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; line-height: 1.6; }
        main { max-width: 32rem; padding: 2rem; background: var(--surface); border: 1px solid var(--border); border-radius: 0.75rem; text-align: center; }
        img { border-radius: 50%; }
        h1 { font-size: 1.5rem; margin: 1rem 0 0.5rem; }
        p { color: var(--muted); margin: 0 0 1.5rem; }
        a { display: inline-block; padding: 0.5rem 1rem; border-radius: 0.5rem; background: var(--brand); color: #fff; text-decoration: none; font-weight: 600; }
        @@media (prefers-color-scheme: dark) { a { color: #10210a; } }
    </style>
</head>
<body>
    <main>
        <img src="~/images/AppIcon_36x36.png" alt="" width="48" height="48" />
        <h1>Something went wrong</h1>
        <p>An error occurred while processing your request. Please try again shortly.</p>
        <a href="~/">Back to Open Charge Map</a>
    </main>
</body>
</html>
