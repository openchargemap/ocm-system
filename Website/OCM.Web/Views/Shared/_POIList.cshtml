@model IEnumerable<OCM.API.Common.Model.ChargePoint>

<p class="small text-body-secondary mb-2">
    @if (@Model.Count() >= 100)
    {
        @:Showing a maximum of 100 matching results
    }
    else
    {
        @:There are @Model.Count() matching results
    }
</p>
<div class="results-list ocm-poi-list">
    @foreach (var item in Model.Take(100))
    {
        var addressParts = new[] { item.AddressInfo.AddressLine1, item.AddressInfo.AddressLine2, item.AddressInfo.Town, item.AddressInfo.StateOrProvince, item.AddressInfo.Postcode, item.AddressInfo.Country?.Title }
            .Where(p => !string.IsNullOrWhiteSpace(p));

        <article class="result ocm-poi-card">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <h3 class="ocm-poi-card-title">
                    <a class="stretched-link" href="@Url.Action("Details","POI",new{ID=item.ID})">@Html.DisplayFor(m => item.AddressInfo.Title)</a>
                </h3>
                <div class="ocm-poi-card-counts text-body-secondary small text-nowrap">
                    @if (item.UserComments != null)
                    {
                        <span title="Comments"><i class="fa-regular fa-comment" aria-hidden="true"></i> @item.UserComments.Count</span>
                    }
                    @if (item.MediaItems != null)
                    {
                        <span title="Photos"><i class="fa-solid fa-camera" aria-hidden="true"></i> @item.MediaItems.Count</span>
                    }
                </div>
            </div>

            <div class="ocm-poi-card-address">@string.Join(", ", addressParts)</div>

            <div class="ocm-poi-card-meta">
                @if (item.AddressInfo.Distance != null)
                {
                    <span><i class="fa-solid fa-location-arrow" aria-hidden="true"></i> @(Math.Round(item.AddressInfo.Distance.Value, 2)) @item.AddressInfo.DistanceUnit</span>
                }
                @if (item.UsageType != null)
                {
                    <span>@item.UsageType.Title</span>
                }
                @if (item.StatusType != null)
                {
                    if (item.StatusType.IsOperational != true)
                    {
                        <span class="badge text-bg-warning">@item.StatusType.Title</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-success-subtle text-success-emphasis">@item.StatusType.Title</span>
                    }
                }

                @if (item.Connections != null && item.Connections.Count > 0)
                {
                    var maxLevel = item.Connections[0];
                    foreach (var c in item.Connections)
                    {
                        if (maxLevel.Level == null && c.Level != null)
                        {
                            maxLevel = c;
                        }
                        else
                        {
                            if (c.Level != null)
                            {
                                if (maxLevel.Level.ID > maxLevel.Level.ID)
                                {
                                    maxLevel = c;
                                }
                            }
                        }
                    }

                    if (maxLevel.Level != null)
                    {
                        var connectionType = "";
                        if (maxLevel.ConnectionType != null) { connectionType = maxLevel.ConnectionType.Title; }
                        <span><i class="fa-solid fa-bolt" aria-hidden="true"></i> @maxLevel.Level.Title</span>
                        @if (!string.IsNullOrEmpty(connectionType))
                        {
                            <span><i class="fa-solid fa-plug" aria-hidden="true"></i> @connectionType</span>
                        }
                    }
                }
            </div>
        </article>
    }
</div>
