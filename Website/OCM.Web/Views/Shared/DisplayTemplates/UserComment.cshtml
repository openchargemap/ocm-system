@model OCM.API.Common.Model.UserComment
@using Microsoft.AspNetCore.Http;
@using Microsoft.AspNetCore.Html;
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    bool isAdministrator = bool.Parse(HttpContextAccessor.HttpContext.Session.GetString("IsAdministrator") ?? "false");
}

<article class="card ocm-comment">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            @if (ViewBag.ShowPOILink == true)
            {
                <a class="fw-semibold" href="@Url.Action("Details", "POI", new { id = Model.ChargePointID })">OCM-@Model.ChargePointID</a>
            }
            @if (Model.CommentType != null)
            {
                <span class="badge rounded-pill bg-body-tertiary text-body-secondary border">@Model.CommentType.Title</span>
            }
            @if (Model.CheckinStatusType != null)
            {
                <span class="badge rounded-pill @(Model.CheckinStatusType.IsPositive == true ? "bg-success-subtle text-success-emphasis" : "bg-body-tertiary text-body-secondary border")">@Model.CheckinStatusType.Title</span>
            }
            @if (Model.Rating != null)
            {
                <span class="ocm-rating" title="Rating: @Model.Rating out of 5">
                    @for (var star = 1; star <= 5; star++)
                    {
                        <i class="@(star <= Model.Rating ? "fa-solid" : "fa-regular") fa-star" aria-hidden="true"></i>
                    }
                    <span class="visually-hidden">Rating: @Model.Rating out of 5</span>
                </span>
            }
        </div>

        <p class="mb-2">@Html.DisplayFor(m => m.Comment)</p>
        @if (Model.RelatedURL != null)
        {
            <div class="small text-break mb-2">@Html.DisplayFor(m => m.RelatedURL)</div>
        }

        <div class="small text-body-secondary">
            Comment by
            <cite>
                @if (Model.User != null)
                {
                    <a href="@Url.Action("View", "Profile", new {id=Model.User.ID })">@Html.DisplayFor(m => m.User.Username)</a>
                }
                else
                {
                    if (!String.IsNullOrEmpty(Model.UserName))
                    {
                        @Html.DisplayFor(m => m.UserName)
                    }
                    else
                    {<text>(Anonymous)</text>}
                }
            </cite>
            &middot; @Html.DisplayFor(m => m.DateCreated)
        </div>

        @if (isAdministrator || ViewBag.UserCanEditPOI == true)
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                @if (isAdministrator)
                {
                    <a class="btn btn-sm btn-outline-danger" href="@Url.Action("CommentDelete", "Admin", new { id=Model.ID})" target="_blank"><i class="fa-solid fa-xmark me-1" aria-hidden="true"></i>Delete (as Admin)</a>
                }

                @if (ViewBag.UserCanEditPOI == true)
                {
                    if (Model.IsActionedByEditor != true)
                    {
                        <a class="btn btn-sm btn-outline-warning" href="@Url.Action("CommentActioned", "POI", new { poiId = Model.ChargePointID, commentId = Model.ID })" target="_blank"><i class="fa-solid fa-square-check me-1" aria-hidden="true"></i>Mark as Actioned</a>
                    }
                    else
                    {
                        <span class="badge text-bg-info align-self-center">Comment Actioned By Editor</span>
                    }
                }
            </div>
        }
    </div>
</article>
