@model OCM.API.Common.Model.UserComment

@using (Html.BeginForm("Comment", "POI"))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    @Html.HiddenFor(model => model.ID)
    @Html.HiddenFor(model => model.ChargePointID)

    <div class="mb-3">
        @Html.LabelFor(model => model.CommentType, new { @class = "form-label" })
        @Html.DropDownListFor(model => model.CommentType.ID, (SelectList)ViewBag.ReferenceData.UserCommentTypeList, new { @class = "form-select" })
        @Html.ValidationMessageFor(model => model.CommentType)
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.CheckinStatusType, new { @class = "form-label" })
        @Html.DropDownListFor(model => model.CheckinStatusType.ID, (SelectList)ViewBag.ReferenceData.CheckinStatusTypeList, new { @class = "form-select" })
        @Html.ValidationMessageFor(model => model.CheckinStatusType)
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.Comment, new { @class = "form-label" })
        @Html.TextAreaFor(model => model.Comment, 4, 40, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.Comment)
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.Rating, new { @class = "form-label" })
        @Html.DropDownListFor(model => model.Rating, (SelectList)ViewBag.ReferenceData.RatingTypeList, new { @class = "form-select" })
        @Html.ValidationMessageFor(model => model.Rating)
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.RelatedURL, new { @class = "form-label" })
        @Html.EditorFor(model => model.RelatedURL, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.RelatedURL)
    </div>

    <partial name="_TermsLink"/>

    <button type="submit" class="btn btn-primary">Submit Comment</button>
}
