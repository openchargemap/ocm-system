@using OCM.API.Common.Model
@using OCM.MVC
@using OCM.API.Common
@using System.Linq
@using Microsoft.AspNetCore.Http;
@using Microsoft.AspNetCore.Html;
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    //test for language code preference, add to Session if present
    //CommonUtil.DetermineLanguageCode(true, this.ViewContext.RouteData.Values["languagecode"] as string);

    string username = HttpContextAccessor.HttpContext.Session.GetString("Username");

    bool isAdministrator = bool.Parse(HttpContextAccessor.HttpContext.Session.GetString("IsAdministrator") ?? "false");
    int? currentUserId = HttpContextAccessor.HttpContext.Session.GetInt32("UserID");
    var currentUser = currentUserId.HasValue ? new UserManager().GetUser(currentUserId.Value) : null;
    bool canReviewOperatorProposals = isAdministrator || (currentUser != null &&
        new ReferenceDataManager().GetCountries(false).Any(country => UserManager.HasUserPermission(currentUser, country.ID, PermissionLevel.Editor)));

    bool isHome = ViewBag.IsHome == true;
    string currentController = (ViewContext.RouteData.Values["controller"] as string ?? "").ToLowerInvariant();
    Func<string[], string> activeFor = controllers => controllers.Contains(currentController) ? " active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Open Charge Map - @ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="@ViewBag.Description" />
    <meta name="author" content="openchargemap.org" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#1f6f35" />

    <script>
        // apply the saved or preferred colour scheme before first paint to avoid a flash
        (function () {
            var stored = null;
            try { stored = localStorage.getItem("ocm-theme"); } catch (e) { }
            var theme = stored === "light" || stored === "dark" ? stored : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            document.documentElement.setAttribute("data-bs-theme", theme);
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/v4-shims.min.css">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />

    <!-- jQuery is loaded before Bootstrap so Bootstrap registers its jQuery plugins ($(..).modal(), .tab() etc.) used by existing pages -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

    <!--fav and touch icons -->
    <link rel="shortcut icon" href="/images/AppIcon_36x36.png">

    <!-- Begin Cookie Consent plugin by Silktide - http://silktide.com/cookieconsent -->
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/cookieconsent2/3.0.3/cookieconsent.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cookieconsent2/3.0.3/cookieconsent.min.js"></script>
    <script>
        window.addEventListener("load", function () {
            window.cookieconsent.initialise({
                "palette": {
                    "popup": {
                        "background": "#1c2620",
                        "text": "#f1f5f2"
                    },
                    "button": {
                        "background": "#8ec760",
                        "text": "#10210a"
                    }
                },
                "theme": "edgeless",
                "position": "bottom-right",
                "content": {
                    "href": "https://openchargemap.org/site/about/terms"
                }
            })
        });
    </script>
    <!-- End Cookie Consent plugin -->

    <script>
        function mapLoaded() {
            document.getElementById("map-loading").style.display = "none";
        }
    </script>

    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Z72QN2CCLC"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-Z72QN2CCLC');
    </script>
</head>
<body class="@(isHome ? "ocm-home" : "") d-flex flex-column min-vh-100">

