    <script>
        // colour theme picker (light / dark / auto)
        (function () {
            var media = window.matchMedia("(prefers-color-scheme: dark)");
            var icons = { light: "fa-sun", dark: "fa-moon", auto: "fa-circle-half-stroke" };

            function getStored() {
                try { return localStorage.getItem("ocm-theme") || "auto"; } catch (e) { return "auto"; }
            }

            function apply(choice) {
                var theme = choice === "auto" ? (media.matches ? "dark" : "light") : choice;
                document.documentElement.setAttribute("data-bs-theme", theme);

                var icon = document.querySelector("[data-theme-icon]");
                if (icon) {
                    icon.classList.remove("fa-sun", "fa-moon", "fa-circle-half-stroke");
                    icon.classList.add(icons[choice] || icons.auto);
                }
                document.querySelectorAll("[data-theme-value]").forEach(function (btn) {
                    btn.classList.toggle("active", btn.getAttribute("data-theme-value") === choice);
                });
            }

            document.querySelectorAll("[data-theme-value]").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    var choice = btn.getAttribute("data-theme-value");
                    try { localStorage.setItem("ocm-theme", choice); } catch (e) { }
                    apply(choice);
                });
            });

            media.addEventListener("change", function () {
                if (getStored() === "auto") apply("auto");
            });

            apply(getStored());
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    @*
        @Html.Raw(CommonUtil.GetLocalizationScriptBlock(Url.Content("~/scripts"), this.ViewContext.RouteData.Values["languagecode"] as string))
