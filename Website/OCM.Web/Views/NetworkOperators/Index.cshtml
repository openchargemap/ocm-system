@model OCM.Web.Models.NetworkOperatorListModel
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewBag.Title = Model.IsSearch
        ? $"Network Operators matching “{Model.SearchTerm}”"
        : Model.Country != null ? $"Network Operators in {Model.Country.Title}" : "Network Operators";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12 col-xl-10">
            <h2 class="mb-2">@ViewBag.Title</h2>
            <p class="text-muted mb-4">Networks and operators used to label charging locations. Operators belong to a single country, so an international network has a separate entry for each country it covers.</p>

            @if (TempData["StatusMessage"] != null)
            {
                <div class="alert alert-success">@TempData["StatusMessage"]</div>
            }

            <div class="d-flex flex-wrap align-items-center mb-3">
                @using (Html.BeginForm("Index", "NetworkOperators", FormMethod.Get, new { @class = "form-inline mr-auto" }))
                {
                    <label class="mr-2 mb-2" for="search">Search by name</label>
                    <input type="search" id="search" name="search" value="@Model.SearchTerm" placeholder="operator name" class="form-control mr-3 mb-2" />

                    <label class="mr-2 mb-2" for="countryId">Country</label>
                    @Html.DropDownList("countryId", (List<SelectListItem>)ViewBag.CountryFilterList, new { @class = "custom-select mr-2 mb-2" })
                    <button type="submit" class="btn btn-outline-secondary mb-2">Show</button>
                }

                @if (Model.CanAddOperator)
                {
                    <a href="@Url.Action("Add", new { countryId = Model.AddForCountryID })" class="btn btn-primary mb-2">Add Operator</a>
                }
            </div>

            @if (Model.IsSearch)
            {
                <p class="text-muted">
                    Searching every country for “<strong>@Model.SearchTerm</strong>”, so the country filter does not apply.
                    <a href="@Url.Action("Index", new { countryId = Model.AddForCountryID })">Clear search</a>
                </p>
            }

            @if (!Model.Operators.Any())
            {
                <div class="alert alert-info">
                    @if (Model.IsSearch)
                    {
                        <text>No operators match “@Model.SearchTerm” in any country.</text>
                    }
                    else
                    {
                        <text>No operators are listed@(Model.Country != null ? " for " + Model.Country.Title : "") yet.</text>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">@Model.TotalResults operator(s).</p>

                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Country</th>
                                <th>Operator</th>
                                <th>Website</th>
                                <th>Contact email</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Operators)
                            {
                                <tr>
                                    <td>@(item.CountryName ?? item.CountryCode ?? "—")</td>
                                    <td><a href="@Url.Action("Index", "POI", new { operatorids = item.Operator.ID })">@item.Operator.Title</a></td>
                                    <td>
                                        @if (item.WebsiteLink != null)
                                        {
                                            <a href="@item.WebsiteLink" target="_blank" rel="noopener noreferrer">@item.Operator.WebsiteURL</a>
                                        }
                                        else
                                        {
                                            @item.Operator.WebsiteURL
                                        }
                                    </td>
                                    <td>@item.Operator.ContactEmail</td>
                                    <td>
                                        @if (item.CanEdit)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Edit", new { id = item.Operator.ID })">Edit</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-3 d-flex justify-content-center justify-content-md-end" aria-label="Network operator pages">
                        <ul class="pagination mb-0">
                            <li class="page-item@(!Model.HasPreviousPage ? " disabled" : "")">
                                @if (Model.HasPreviousPage)
                                {
                                    <a class="page-link" rel="prev" href="@Url.Action("Index", new { countryId = ViewContext.HttpContext.Request.Query["countryId"], search = Model.SearchTerm, page = Model.Page - 1 })">Previous</a>
                                }
                                else
                                {
                                    <span class="page-link">Previous</span>
                                }
                            </li>
                            <li class="page-item disabled" aria-current="page"><span class="page-link">Page @Model.Page of @Model.TotalPages</span></li>
                            <li class="page-item@(!Model.HasNextPage ? " disabled" : "")">
                                @if (Model.HasNextPage)
                                {
                                    <a class="page-link" rel="next" href="@Url.Action("Index", new { countryId = ViewContext.HttpContext.Request.Query["countryId"], search = Model.SearchTerm, page = Model.Page + 1 })">Next</a>
                                }
                                else
                                {
                                    <span class="page-link">Next</span>
                                }
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
