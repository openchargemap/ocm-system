@{ ViewBag.Title = "Suggest an Operator or Correction"; }

<div class="container-fluid">
    <div class="row">
        <div class="col-12 col-lg-10 col-xl-8">
            <h2 class="mb-2">Suggest an Operator or Correction</h2>
            <p class="text-muted mb-4">All submissions are reviewed before they change public data.</p>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h3 class="h5">Propose a new operator</h3>
                            <p class="text-muted">Submit an operator that is not currently listed.</p>
                            <a class="btn btn-primary mt-auto align-self-start" href="@Url.Action("Add")">Propose a new operator</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h3 class="h5">Suggest a correction</h3>
                            <p class="text-muted">Find an existing operator and suggest updated details for review.</p>
                            <a class="btn btn-primary mt-auto align-self-start" href="@Url.Action("Edit")">Suggest a correction</a>
                        </div>
                    </div>
                </div>
            </div>

            <a class="btn btn-outline-secondary" href="@Url.Action("MySubmissions")">View my submissions</a>
        </div>
    </div>
</div>
