@model OCM.Web.Models.CountryOperatorIndexModel

@{
    ViewBag.Title = "Manage Country Operators";
    var singleEditableCountry = ViewBag.SingleEditableCountry as OCM.API.Common.Model.Country;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12 col-lg-10 col-xl-8">
            <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
                <div>
                    <h2 class="mb-2">Manage country operators</h2>
                    <p class="text-muted mb-0">Add or edit operator labels for the countries you manage.</p>
                </div>
                <a href="@Url.Action("Add", "CountryOperators")" class="btn btn-primary mt-2">Add country operator</a>
            </div>

            <div class="card mb-4">
                <div class="card-header h5 mb-0">Filter country operators</div>
                <div class="card-body">
                    @using (Html.BeginForm("Index", "CountryOperators", FormMethod.Get))
                    {
                        <div class="form-row align-items-end">
                            <div class="form-group col-md-5 mb-md-0">
                                <label>Country</label>
                                @if (singleEditableCountry != null)
                                {
                                    <div class="form-control-plaintext">@singleEditableCountry.Title</div>
                                    @Html.Hidden("countryId", singleEditableCountry.ID)
                                }
                                else
                                {
                                    @Html.DropDownList("countryId", (SelectList)ViewBag.CountryList, "Select a country", new { @class = "custom-select", required = "required" })
                                }
                            </div>
                            <div class="form-group col-md-5 mb-md-0">
                                <label for="searchTerm">Operator name</label>
                                <input type="search" id="searchTerm" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by operator name" minlength="2" />
                            </div>
                            <div class="form-group col-md-2 mb-0">
                                <button type="submit" class="btn btn-outline-secondary btn-block form-control">Apply</button>
                            </div>
                        </div>
                        <small class="form-text text-muted mt-2">Browse or search operators in one of the countries you manage.</small>
                    }
                </div>
            </div>

            @if (!Model.HasCountry)
            {
                <div class="alert alert-info">Select a country to browse or search its operators.</div>
            }
            else if (ViewBag.SearchTooShort == true)
            {
                <div class="alert alert-danger">Enter at least 2 characters to search.</div>
            }
            else if (!Model.Operators.Any())
            {
                <div class="alert alert-info">No matching country operators found.</div>
            }
            else
            {
                <div class="card">
                    <div class="card-header h5 mb-0">@Model.TotalResults @(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "country operator" : "matching country operator")@(Model.TotalResults == 1 ? "" : "s")</div>
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.Operators)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap">
                                <div>
                                    <strong>@item.Title</strong>
                                    <div class="text-muted">@item.CountryTitle</div>
                                    @if (!string.IsNullOrWhiteSpace(item.WebsiteURL))
                                    {
                                        <small class="text-muted">@item.WebsiteURL</small>
                                    }
                                </div>
                                <a href="@Url.Action("Edit", "CountryOperators", new { id = item.ID })" class="btn btn-outline-secondary mt-2">Edit</a>
                            </div>
                        }
                    </div>
                </div>
                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-3" aria-label="Country operator search results">
                        <ul class="pagination">
                            <li class="page-item@(Model.Page == 1 ? " disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { countryId = Model.CountryID, searchTerm = Model.SearchTerm, page = Model.Page - 1 })">Previous</a>
                            </li>
                            <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages</span></li>
                            <li class="page-item@(Model.Page == Model.TotalPages ? " disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { countryId = Model.CountryID, searchTerm = Model.SearchTerm, page = Model.Page + 1 })">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
