@model OCM.Web.Models.CountryOperatorEditModel
@using System.Collections.Generic
@using System.Linq
@using OCM.API.Common

@{
    ViewBag.Title = Model.ID > 1 ? "Edit Country Operator" : "Add Country Operator";
    var duplicateTitleMatch = ViewBag.DuplicateTitleMatch as OperatorMatch;
    var possibleDuplicates = ViewBag.PossibleDuplicates as IEnumerable<OperatorMatch> ?? Enumerable.Empty<OperatorMatch>();
    var otherCountryMatches = ViewBag.OtherCountryMatches as IEnumerable<OperatorMatch> ?? Enumerable.Empty<OperatorMatch>();
    var singleEditableCountry = ViewBag.SingleEditableCountry as OCM.API.Common.Model.Country;
    var isEditing = Model.ID > 1;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12 col-lg-10 col-xl-8">
            <h2 class="mb-2">@ViewBag.Title</h2>
            <p class="text-muted mb-4">@(isEditing ? "Update this operator’s details for the selected country." : "Create an operator label for charging locations in the selected country.")</p>

            @if (TempData["StatusMessage"] != null)
            {
                <div class="alert alert-success">@TempData["StatusMessage"]</div>
            }

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "Please correct the following:", new { @class = "alert alert-danger" })
                @Html.HiddenFor(model => model.ID)

                <div class="card mb-4">
                    <div class="card-header h5 mb-0">Identity</div>
                    <div class="card-body">
                        <div class="form-group">
                            @Html.LabelFor(model => model.CountryID)
                            @if (singleEditableCountry != null)
                            {
                                <div class="form-control-plaintext">@singleEditableCountry.Title</div>
                                @Html.HiddenFor(model => model.CountryID)
                            }
                            else
                            {
                                @Html.DropDownListFor(model => model.CountryID, (SelectList)ViewBag.CountryList, "Select a country", new { @class = "custom-select" })
                            }
                            @Html.ValidationMessageFor(model => model.CountryID)
                            <small class="form-text text-muted">The country code is added to the saved operator title automatically.</small>
                        </div>
                        <div class="form-group mb-0">
                            @Html.LabelFor(model => model.OperatorName)
                            @Html.EditorFor(model => model.OperatorName, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.OperatorName)
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header h5 mb-0">Website</div>
                    <div class="card-body">
                        <div class="form-group mb-0">
                            @Html.LabelFor(model => model.WebsiteURL)
                            @Html.EditorFor(model => model.WebsiteURL, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.WebsiteURL)
                            <small class="form-text text-muted">Required. The operator’s public website is used to check for existing operators.</small>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header h5 mb-0">Contact details</div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 form-group">
                                @Html.LabelFor(model => model.PhonePrimaryContact)
                                @Html.EditorFor(model => model.PhonePrimaryContact, new { htmlAttributes = new { @class = "form-control" } })
                            </div>
                            <div class="col-md-6 form-group mb-md-0">
                                @Html.LabelFor(model => model.PhoneSecondaryContact)
                                @Html.EditorFor(model => model.PhoneSecondaryContact, new { htmlAttributes = new { @class = "form-control" } })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 form-group">
                                @Html.LabelFor(model => model.ContactEmail)
                                @Html.EditorFor(model => model.ContactEmail, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.ContactEmail)
                            </div>
                            <div class="col-md-6 form-group mb-0">
                                @Html.LabelFor(model => model.FaultReportEmail)
                                @Html.EditorFor(model => model.FaultReportEmail, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.FaultReportEmail)
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header h5 mb-0">Notes</div>
                    <div class="card-body">
                        <div class="form-group mb-0">
                            @Html.LabelFor(model => model.Comments)
                            @Html.TextAreaFor(model => model.Comments, new { @class = "form-control", rows = 4 })
                        </div>
                    </div>
                </div>

                @if (duplicateTitleMatch != null)
                {
                    <div class="alert alert-danger">
                        <strong>@duplicateTitleMatch.Operator.Title is already listed for this country.</strong>
                        <p class="mb-0">Each operator name can only be used once per country. Edit the existing operator instead of adding a new one.</p>
                    </div>
                }

                @if (possibleDuplicates.Any())
                {
                    <div class="alert alert-warning">
                        <strong>This may already exist</strong>
                        <p>Check these operators before continuing. If yours is genuinely a different company, confirm below and save.</p>
                        <ul>
                            @foreach (var match in possibleDuplicates)
                            {
                                <li><strong>@match.Operator.Title</strong> — @match.Reason</li>
                            }
                        </ul>
                        <div class="custom-control custom-checkbox">
                            @Html.CheckBoxFor(model => model.ConfirmNotDuplicate, new { @class = "custom-control-input" })
                            @Html.LabelFor(model => model.ConfirmNotDuplicate, "I have checked these and this is a separate operator", new { @class = "custom-control-label" })
                        </div>
                    </div>
                }

                @if (otherCountryMatches.Any())
                {
                    <div class="alert alert-info">
                        <strong>Already listed for other countries</strong>
                        <p>Networks operating in several countries have one operator per country, so this is expected and needs no action.</p>
                        <ul class="mb-0">
                            @foreach (var match in otherCountryMatches)
                            {
                                <li>@match.Operator.Title</li>
                            }
                        </ul>
                    </div>
                }

                <div id="client-duplicate-warning" class="alert alert-warning" style="display:none;"></div>

                <div class="d-flex flex-wrap mb-4">
                    <input type="submit" value="@(isEditing ? "Save changes" : "Create operator")" class="btn btn-primary mr-2 mb-2" />
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary mb-2">Cancel</a>
                </div>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        var form = document.querySelector('form');
        var country = document.getElementById('CountryID');
        var name = document.getElementById('OperatorName');
        var website = document.getElementById('WebsiteURL');
        var contactEmail = document.getElementById('ContactEmail');
        var warning = document.getElementById('client-duplicate-warning');
        var requestId = 0;
        var timer;
        var hasServerWarning = @((duplicateTitleMatch != null || possibleDuplicates.Any()).ToString().ToLowerInvariant());

        function escapeHtml(value) {
            return $('<div>').text(value || '').html();
        }

        function render(matches) {
            if (!matches || matches.length === 0) {
                warning.style.display = 'none';
                warning.innerHTML = '';
                return;
            }

            var exact = matches.some(function (match) { return match.matchType === 0; });
            var html = '<strong>' + (exact ? 'This operator is already listed' : 'This may already exist') + '</strong>';
            html += '<p>Check these operators before continuing.' + (exact ? ' Edit the existing operator instead of adding a new one.' : ' If yours is genuinely a different company, confirm below and save.') + '</p><ul>';
            matches.forEach(function (match) {
                html += '<li><strong>' + escapeHtml(match.title) + '</strong> — ' + escapeHtml(match.matchReason) + '</li>';
            });
            html += '</ul>';
            if (!exact) {
                html += '<div class="custom-control custom-checkbox">' +
                    '<input type="checkbox" name="ConfirmNotDuplicate" value="true" class="custom-control-input" id="client-confirm-not-duplicate">' +
                    '<label class="custom-control-label" for="client-confirm-not-duplicate">I have checked these and this is a separate operator</label>' +
                    '</div>';
            }
            warning.className = exact ? 'alert alert-danger' : 'alert alert-warning';
            warning.innerHTML = html;
            warning.style.display = '';
        }

        function checkDuplicates() {
            if (hasServerWarning) return;
            if (name.value.trim().length < 2 || country.value === '') {
                render([]);
                return;
            }
            var currentRequest = ++requestId;
            $.ajax({
                url: '@Url.Action("CheckDuplicates", "OperatorProposals")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: form.querySelector('input[name="__RequestVerificationToken"]').value,
                    operatorName: name.value,
                    websiteUrl: website.value,
                    contactEmail: contactEmail.value,
                    scope: 1,
                    countryId: country.value,
                    operatorId: document.getElementById('ID').value
                }
            }).done(function (result) {
                if (currentRequest === requestId) render(result.matches);
            });
        }

        function scheduleCheck() {
            clearTimeout(timer);
            timer = setTimeout(checkDuplicates, 350);
        }

        [country, name, website, contactEmail].forEach(function (field) {
            field.addEventListener('change', scheduleCheck);
            field.addEventListener('blur', scheduleCheck);
        });
    })();
</script>
