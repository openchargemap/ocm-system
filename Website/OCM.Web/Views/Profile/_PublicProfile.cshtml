@model OCM.API.Common.Model.User

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 mb-4">
                    @if (!string.IsNullOrEmpty(Model.ProfileImageURL))
                    {
                        <img class="ocm-avatar ocm-avatar-lg" src="@Model.ProfileImageURL" alt="" />
                    }
                    else
                    {
                        <span class="ocm-avatar ocm-avatar-lg d-inline-grid" aria-hidden="true"><i class="fa-solid fa-user m-auto text-body-secondary"></i></span>
                    }
                    <div>
                        <h2 class="h4 mb-0">
                            @if (Model.IdentityProvider == "Twitter")
                            {
                                <a href="https://twitter.com/@Model.Identifier" target="_blank">@Html.DisplayFor(model => model.Username)</a>
                            }
                            else
                            {
                                @Html.DisplayFor(model => model.Username)
                            }
                        </h2>
                        @if (!string.IsNullOrEmpty(Model.Location))
                        {
                            <div class="text-body-secondary small"><i class="fa-solid fa-location-dot me-1" aria-hidden="true"></i>@Html.DisplayFor(model => model.Location)</div>
                        }
                    </div>
                </div>

                <dl class="ocm-facts mb-0">
                    <dt>@Html.DisplayNameFor(model => model.DateCreated)</dt>
                    <dd>@Html.DisplayFor(model => model.DateCreated)</dd>
                    <dt>@Html.DisplayNameFor(model => model.Profile)</dt>
                    <dd>@Html.DisplayFor(model => model.Profile)</dd>
                    <dt>@Html.DisplayNameFor(model => model.Location)</dt>
                    <dd>@Html.DisplayFor(model => model.Location)</dd>
                    <dt>@Html.DisplayNameFor(model => model.WebsiteURL)</dt>
                    <dd class="text-break">@Html.DisplayFor(model => model.WebsiteURL)</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="ocm-stat h-auto">
            <span class="ocm-stat-value" id="summary-reputation">@Html.DisplayFor(model => model.ReputationPoints)</span>
            <span class="ocm-stat-label">Community points</span>
        </div>
    </div>
</div>
