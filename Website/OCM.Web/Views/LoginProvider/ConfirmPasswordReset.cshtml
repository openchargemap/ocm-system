@{
    ViewBag.Title = "Password Reset";
}

<div class="ocm-auth">
    <h1 class="h3">Password Reset Failed</h1>
    <p class="alert alert-warning">We could not continue with the requested password reset. Please check you are using the latest confirmation link sent to you as only the latest link will work.</p>

    <a class="btn btn-primary w-100" href="@Url.Action("PasswordReset", "LoginProvider")">Request another password reset</a>
</div>
