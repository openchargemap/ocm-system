@model OCM.API.Common.Model.PasswordResetRequestModel

<div class="ocm-auth">
    @if (Model.ResetInitiated)
    {
        <h1 class="h3">Confirmation Email Sent</h1>
        <p class="text-body-secondary mb-0">We have sent an email with a confirmation link. Follow the link to complete your password reset.</p>
    }
    else
    {
        <h1 class="h3">Reset Your Password</h1>

        if (Model.IsObsoleteLoginProvider)
        {
            <p class="alert alert-warning">Your Login Provider (Google) is no longer supported however if we have your email address you can still set a password and sign in normally. You will need to reset your password to proceed.</p>
        }

        using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <p class="text-body-secondary">To confirm your password reset we need to send you a confirmation email. Enter the email address you have registered against your Open Charge Map profile:</p>
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="mb-3">
                @Html.LabelFor(model => model.EmailAddress, htmlAttributes: new { @class = "form-label" })
                @Html.EditorFor(model => model.EmailAddress, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.EmailAddress, "", new { @class = "text-danger" })
            </div>

            @if (Model.IsUnknownAccount)
            {
                <p class="alert alert-danger">
                    We could not send a password reset confirmation email. The email address supplied may not match a known user account. Please try again.
                </p>
            }
            <button type="submit" class="btn btn-primary w-100">Request Password Reset</button>
        }
    }
</div>
